# Gemini API Key for AI features (receipt parsing, roasting, insights, etc.)
# Get your API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_api_key_here

# Supabase Configuration (if using cloud sync)
# Get from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Vercel Speed Insights (optional)
# Enables real-time performance monitoring
# The package auto-detects the project ID when deployed on Vercel
# For other platforms, set your Vercel project ID here
# VITE_VERCEL_SPEED_INSIGHTS_ID=your_project_id
