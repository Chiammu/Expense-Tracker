# Gemini API Key for AI features (receipt parsing, roasting, insights, etc.)
# IMPORTANT: This should ONLY be set on the server (Vercel environment variables)
# Never commit this to git or expose in client code
GEMINI_API_KEY=your_api_key_here

# API Base URL (for production, set to your Vercel domain)
# Leave empty for development (defaults to same origin)
VITE_API_BASE=

# Supabase Configuration (if using cloud sync)
# Get from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
